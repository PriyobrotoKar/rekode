{
  "name": "@rekode/types",
  "version": "0.0.0",
  "scripts": {
    "build": "tsup src/**/*.ts --format cjs,esm --dts",
    "gen-proto-types:client": "bunx protoc --ts_proto_opt=outputServices=none --ts_proto_opt=useNullAsOptional=true --proto_path=.. --ts_proto_out=./src/client ../proto/*.proto",
    "gen-proto-types:server": "bunx protoc --ts_proto_opt=nestJs=true --ts_proto_opt=useNullAsOptional=true --proto_path=.. --ts_proto_out=./src/server ../proto/*.proto",
    "gen-proto-types": "bun run gen-proto-types:client && bun run gen-proto-types:server"
  },
  "exports": {
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js",
      "require": "./dist/client/*.cjs"
    },
    "./server/*": {
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js",
      "require": "./dist/server/*.cjs"
    }
  },
  "dependencies": {
    "@nestjs/microservices": "catalog:nestjs",
    "rxjs": "catalog:nestjs"
  },
  "devDependencies": {
    "ts-proto": "^2.11.4",
    "@rekode/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "private": true,
  "type": "module"
}
