// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TemplateEnvironment {
  BROWSER
  SERVER
}

model Template {
  id           String              @id @default(cuid())
  slug         String              @unique
  description  String?
  technologies String[]
  language     String
  environment  TemplateEnvironment
  repoUrl      String
  installCmd   String
  buildCmd     String
  startCmd     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
