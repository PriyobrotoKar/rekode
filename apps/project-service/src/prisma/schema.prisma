// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  CREATED
  RUNNING
  PAUSED
  RESTARTING
  REMOVING
  EXITED
  DEAD
}

model Project {
  id             String            @id @default(cuid())
  slug           String            @unique
  description    String?
  visibility     ProjectVisibility @default(PUBLIC)
  fileSystemPath String
  status         ProjectStatus     @default(DEAD)
  containerUrl   String?

  templateId String
  userId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
